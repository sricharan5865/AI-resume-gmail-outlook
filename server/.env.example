# ============================================================
# TalentFlow Server - Environment Variables
# ------------------------------------------------------------
# Copy this file to .env and fill in your values.
# Windows: Works with defaults (no .env needed for local dev)
# Linux:   Must set FRONTEND_URL to your Linux machine's IP
# ============================================================

# --- Server ---
PORT=5000

# --- Frontend URL (CORS) ---
# Windows local dev: leave as default (http://localhost:5173)
# Linux / remote access: set to your machine's IP
# Example: FRONTEND_URL=http://192.168.1.100:5173
FRONTEND_URL=http://localhost:5173

# --- Extra allowed CORS origins (comma-separated, optional) ---
# EXTRA_ORIGINS=http://192.168.1.101:5173,http://10.0.0.5:5173

# --- MongoDB ---
# Windows local: leave as default
# Linux / remote MongoDB: change the host/credentials
MONGO_URI=mongodb://admin:password@localhost:27017/talentflow?authSource=admin

# --- JWT Secret (change this in production!) ---
JWT_SECRET=talentflow-super-secret-key

# --- AI Providers (optional - can also be set via Settings UI) ---
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# CLAUDE_API_KEY=your-claude-api-key

# --- Gmail Integration (optional) ---
# GMAIL_USER_EMAIL=your-gmail@gmail.com
# GMAIL_APP_PASSWORD=your-app-password

# --- Outlook Integration (optional) ---
# OUTLOOK_CLIENT_ID=your-client-id
# OUTLOOK_CLIENT_SECRET=your-client-secret
# OUTLOOK_TENANT_ID=your-tenant-id
# OUTLOOK_USER_EMAIL=your-email@company.com
