# ============================================================
# TalentFlow Client - Environment Variables
# ------------------------------------------------------------
# Copy this file to .env and fill in your values.
# Windows: No .env needed — Vite proxy handles routing automatically
# Linux:   No .env needed for dev — Vite proxy handles routing
#          For production builds (npm run build), set VITE_BACKEND_URL
# ============================================================

# --- Backend URL ---
# Leave EMPTY for development (Vite proxy handles it automatically)
# Set this ONLY for production builds where Vite proxy is not available
# Example: VITE_BACKEND_URL=http://192.168.1.100:5000
VITE_BACKEND_URL=
